# Copy to .env.local for `vercel dev`, and set these in the Vercel dashboard
# (Project → Settings → Environment Variables) for production.

# ---- PM dashboard ----
PM_PIN=1234

# ---- Database: Turso / libSQL ----
# Create a free DB at https://turso.tech, then run:
#   turso db show <name> --url        → TURSO_DATABASE_URL  (libsql://…)
#   turso db tokens create <name>     → TURSO_AUTH_TOKEN
# Leave both blank locally to use a SQLite file (file:local.db) instead.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Slack (optional) ----
# Bot token (xoxb-…) with chat:write + chat:write.public, and the target channel ID.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Public URL of your deployment, used inside the reminder message.
# e.g. https://your-app.vercel.app
PUBLIC_FORM_URL=

# ---- Scheduled reminder ----
# Shared secret the external cron service must send (Bearer token or ?key=)
# to trigger POST/GET /api/reminder. Pick a long random string.
CRON_SECRET=
