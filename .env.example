# Copy to .env.local for local dev (npm run local / npm run seed read it).
# In production these live in the Vercel dashboard → Settings → Environment Variables.

# ---- PM dashboard ----
PM_PIN=1234

# ---- Database: Supabase Postgres ----
# The Vercel ↔ Supabase integration sets POSTGRES_URL automatically. If you
# wire it up manually, grab the connection string from:
#   Supabase → Project Settings → Database → Connection string → "Transaction" pooler
# Use the pooled (port 6543) URL for serverless. Any of these names work:
POSTGRES_URL=
# DATABASE_URL=
# POSTGRES_URL_NON_POOLING=   # direct (port 5432) connection, e.g. for the seed script

# ---- Slack (optional) ----
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
PUBLIC_FORM_URL=

# ---- Scheduled reminder ----
# Shared secret an external cron must send to trigger /api/reminder.
CRON_SECRET=
