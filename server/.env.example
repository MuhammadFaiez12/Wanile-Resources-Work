# ---- Server ----
PORT=4000

# PM Dashboard access PIN (change this!)
PM_PIN=1234

# ---- Slack integration (optional) ----
# Leave blank to run without Slack. The app degrades gracefully:
# reports still save, reminders just won't fire.

# Bot token from your Slack app (xoxb-...)
SLACK_BOT_TOKEN=

# App-level token (xapp-...) — only needed if you enable Socket Mode
SLACK_APP_TOKEN=

# Signing secret from Slack app Basic Information
SLACK_SIGNING_SECRET=

# Channel ID (e.g. C0123456789) where the PM gets submission notifications
# AND where the daily 4:30pm reminder is posted.
SLACK_CHANNEL_ID=

# Timezone used for the 4:30pm weekday reminder cron (IANA name)
REMINDER_TIMEZONE=Asia/Karachi

# Set to "false" to disable the scheduled reminder
REMINDER_ENABLED=true
